# Copy to .env and fill in. Nothing here is a secret that belongs in git.

# --- Odoo (required) -------------------------------------------------------
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database
# auto | jsonrpc | xmlrpc | json2   (auto = probe the server, see docs/VERIFY_REPORT.md)
ODOO_TRANSPORT=auto
ODOO_VERIFY_SSL=true
ODOO_TIMEOUT_S=30

# --- App secrets (required, change both) ------------------------------------
# Used to encrypt Odoo credentials inside the server-side session. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=sticker_dev_pw

# --- Sessions / security -----------------------------------------------------
SESSION_IDLE_SECONDS=1800
# Set true when served over HTTPS (terminate TLS in front of the frontend container).
COOKIE_SECURE=false
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT_SECONDS=900
# Comma-separated Odoo logins that get the template_admin app role on first login.
INITIAL_ADMIN_LOGINS=admin
DEFAULT_ROLE=printer

# --- Resolver ------------------------------------------------------------------
BOM_DEPTH=2
CACHE_TTL_SECONDS=120

# --- Labels / printing ---------------------------------------------------------
DEFAULT_LABEL_SIZE=A6
MAX_UPLOAD_MB=15
RENDER_TIMEOUT_SECONDS=20
# JSON map of ZPL network printers, e.g. {"zebra1":"192.168.1.50:9100"}
PRINTERS={}

HTTP_PORT=8080
