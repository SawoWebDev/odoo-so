# Copy to .env and fill in. Nothing here is a secret that belongs in git.

# --- Odoo (required) -------------------------------------------------------
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database
# Odoo 17 with password login: jsonrpc. (xmlrpc also works; json2 is Odoo 19+ and needs API keys.)
ODOO_TRANSPORT=jsonrpc
ODOO_VERIFY_SSL=true
ODOO_TIMEOUT_S=30

# --- App secrets (required, change both) ------------------------------------
# Used to encrypt Odoo credentials inside the server-side session. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=sticker_dev_pw

# --- Sessions / security -----------------------------------------------------
SESSION_IDLE_SECONDS=1800
# Set true when served over HTTPS (terminate TLS in front of the frontend container).
COOKIE_SECURE=false
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT_SECONDS=900
# Comma-separated Odoo logins that get the admin app role on first login.
INITIAL_ADMIN_LOGINS=admin
DEFAULT_ROLE=printer
CACHE_TTL_SECONDS=120

# --- Label PDFs ---------------------------------------------------------------
# One PDF per item code (e.g. 560-BL.pdf). On the "Label files" tab an admin adds a folder as a URL, e.g.
#   file://172.16.0.4/Marketing/00%20MASTERLIST/01%20PRINTING%20FILES/01%20SAWO/
# The app saves every PDF's name and location in its database and fetches the file from there when you preview or print.
# A URL only works for folders inside what is connected to the container:
LABEL_MOUNT_DIR=/labels
LABEL_SHARE=//172.16.0.4/Marketing
#
# A) Local folder (default): the host folder below is mounted read-only as /labels. Its sub-folders should mirror the share,
#    e.g. <folder>/00 MASTERLIST/01 PRINTING FILES/01 SAWO/...
LABEL_LOCAL_DIR=./labels
#
# B) The real network share: uncomment these lines (the share refuses anonymous access, so a Windows login is needed).
# COMPOSE_FILE=docker-compose.yml:docker-compose.network.yml
# LABEL_SHARE_USER=your-windows-user
# LABEL_SHARE_PASSWORD=your-windows-password
# LABEL_SHARE_DOMAIN=WORKGROUP
#
# Optional: a folder added automatically (once, when no folder exists yet). Same URL forms as on the tab.
LABEL_DEFAULT_LOCATION=
# When one item code has several PDFs (Individual / Box Stickers / No Logo ...), folders whose path contains the
# first word below win as the default (users can still pick another). Comma separated.
LABEL_FOLDER_PRIORITY=
# PDFs bigger than this are viewable but are not merged or copied into the print snapshot.
LABEL_MAX_MB=150

HTTP_PORT=8080
