# Demo configuration: the app talks to the bundled mock Odoo. Use together with: docker compose --profile demo up --build
ODOO_URL=http://mock-odoo:8069
ODOO_DB=demo
ODOO_TRANSPORT=jsonrpc
ODOO_VERIFY_SSL=false
APP_SECRET_KEY=demo-only-not-a-secret-change-for-real-use-0123456789
POSTGRES_PASSWORD=sticker_dev_pw
INITIAL_ADMIN_LOGINS=alice
DEFAULT_ROLE=printer
SESSION_IDLE_SECONDS=1800
COOKIE_SECURE=false
HTTP_PORT=8090
LABEL_LOCAL_DIR=./demo-labels
LABEL_MOUNT_DIR=/labels
LABEL_DEFAULT_LOCATION=/labels
